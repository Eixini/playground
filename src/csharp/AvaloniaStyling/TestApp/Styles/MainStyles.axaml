<ResourceDictionary xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ControlTheme
		x:Key="CustomWindow"
		TargetType="Window"
		BasedOn="{StaticResource {x:Type Window}}">
		<Setter Property="Background" Value="#474A51"/>
	</ControlTheme>
	<ControlTheme
		x:Key="CustomButton"
		TargetType="Button"
		BasedOn="{StaticResource {x:Type Button}}">
		<Setter Property="Background" Value="#34D2AF"/>
		<Setter Property="Foreground" Value="#474A51"/>
		<Setter Property="CornerRadius" Value="15"/>
		
		<Style Selector="^.rightBtn">
			<Setter Property="Background" Value="#00665E"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="^.topBtn">
			<Setter Property="Background" Value="#5DCEC6"/>
		</Style>
	</ControlTheme>
	<ControlTheme
		x:Key="CustomTextBox"
		TargetType="TextBox"
		BasedOn="{StaticResource {x:Type TextBox}}">
		<Setter Property="Background" Value="#474A51"/>
		<Setter Property="BorderBrush" Value="#474A51"/>
		<Setter Property="Foreground" Value="White"/>
	</ControlTheme>
	
</ResourceDictionary>
